<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/config_suggestions_strip_height">
    <!-- To ensure that key preview popup is correctly placed when the current system locale is
         one of RTL locales, layoutDirection="ltr" is needed in the SDK version 17+. -->
    <helium314.keyboard.latin.suggestions.SuggestionStripView
        android:id="@+id/suggestion_strip_view"
        android:layoutDirection="ltr"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        style="?attr/suggestionStripViewStyle" />
    <LinearLayout
        android:id="@+id/emoji_tab_strip"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="?attr/suggestionStripViewStyle">
        <FrameLayout
            android:id="@+id/emoji_toolbar_start_container"
            android:layout_width="61dp"
            android:layout_height="match_parent"
            android:translationY="-3dp">
            <ImageButton
                android:id="@+id/emoji_toolbar_backpack_key"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:contentDescription="@string/clipboard"
                android:padding="0dp"
                android:scaleType="fitCenter"
                style="?attr/suggestionWordStyle" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/emoji_toolbar_end"
            android:layout_width="61dp"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/emoji_toolbar_end_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleY="1.1"
                android:scaleType="fitCenter"
                android:translationX="-4dp"
                android:translationY="-3.13dp"
                android:transformPivotY="0dp" />
            <ImageButton
                android:id="@+id/emoji_toolbar_return_key"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/spoken_description_to_alpha"
                android:padding="0dp"
                android:scaleType="center"
                android:translationY="-3dp"
                style="?attr/suggestionWordStyle" />
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/clipboard_strip_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        style="?attr/suggestionStripViewStyle">
        <HorizontalScrollView
            android:id="@+id/clipboard_strip_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="61dp"
            android:layout_marginEnd="61dp"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/clipboard_strip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:translationY="-3dp" />
        </HorizontalScrollView>
        <FrameLayout
            android:id="@+id/clipboard_toolbar_start_container"
            android:layout_width="61dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:translationY="-3dp">
            <ImageButton
                android:id="@+id/clipboard_toolbar_backpack_key"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:contentDescription="@string/clipboard"
                android:padding="0dp"
                android:scaleType="fitCenter"
                style="?attr/suggestionWordStyle" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/clipboard_toolbar_end"
            android:layout_width="61dp"
            android:layout_height="match_parent"
            android:layout_gravity="end">
            <ImageView
                android:id="@+id/clipboard_toolbar_end_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleY="1.1"
                android:scaleType="fitCenter"
                android:translationX="-4dp"
                android:translationY="-3.13dp"
                android:transformPivotY="0dp" />
            <ImageButton
                android:id="@+id/clipboard_toolbar_return_key"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/spoken_description_to_alpha"
                android:padding="0dp"
                android:scaleType="center"
                android:translationY="-3dp"
                style="?attr/suggestionWordStyle" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
